{
    "name": "topthink/think",
    "description": "ZTBCMS based on ThinkPHP 8",
    "type": "project",
    "keywords": [
        "framework",
        "thinkphp",
        "ORM"
    ],
    "homepage": "http://thinkphp.cn/",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "liu21st",
            "email": "liu21st@gmail.com"
        },
        {
            "name": "yunwuxin",
            "email": "448901948@qq.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "topthink/framework": "^8.1",
        "topthink/think-orm": "^3.0",
        "topthink/think-multi-app": "^1.0",
        "topthink/think-view": "^2.0",
        "topthink/think-queue": "^3.0",
        "aliyuncs/oss-sdk-php": "^2.4",
        "alibabacloud/client": "^1.5",
        "w7corp/easywechat": "4.9.0.1",
        "phpmailer/phpmailer": "^6.3",
        "guzzlehttp/guzzle": "^7.3",
        "topthink/think-migration": "^3.0",
        "predis/predis": "^2.0",
        "nesbot/carbon": "^2.66",
        "firebase/php-jwt": "^7.0",
        "topthink/think-filesystem": "^2.0",
        "league/flysystem": "2.5.0.1",
        "qiniu/php-sdk": "^7.14"
    },
    "require-dev": {
        "symfony/var-dumper": "^6.4|^7.0",
        "topthink/think-trace": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app"
        },
        "psr-0": {
            "": "extend/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "easywechat-composer/easywechat-composer": false
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Jayin/flysystem.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/Jayin/easywechat.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/Jayin/socialite.git",
            "no-api": true
        },
        {
            "type": "composer",
            "url": "https://repo.packagist.org"
        }
    ]
}
